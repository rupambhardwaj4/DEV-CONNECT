# Which data source the app talks to.
#   local — the offline demonstration: mock data in localStorage, simulated round trips.
#   api   — the Express + Prisma service in server/ (start it with `npm run dev:api`).
VITE_DATA_SOURCE=local

# Where the API lives. Must include the version prefix, and the browser origin has to be
# listed in CLIENT_ORIGIN in server/.env or CORS will refuse the credentialed request.
VITE_API_BASE_URL=http://localhost:3000/api/v1

# Environment
VITE_ENV=development
