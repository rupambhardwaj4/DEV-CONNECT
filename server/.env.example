# DevConnect API — copy to server/.env and fill in.
# The database role must own the devconnect schema; never put a superuser password here.
DATABASE_URL="postgresql://devconnect:CHANGE_ME@localhost:5432/devconnect"

# Sign session cookies. Any 32+ char secret of your own; rotating it logs everyone out.
JWT_SECRET="CHANGE_ME_to_a_long_random_string"
JWT_TTL=12h

PORT=3000

# Comma-separated origins allowed to call the API with credentials.
CLIENT_ORIGIN=http://localhost:5173

# Public GitHub calls are limited to 60/hour per IP. A token raises that; leave empty to
# run without one.
GITHUB_API_TOKEN=

PASSWORD_SALT_ROUNDS=10
NODE_ENV=development
